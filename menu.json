  "notes": {
    "pickles": {
      "fr": "Légumes frais marinés sur place dans une préparation vinaigrée, légèrement sucrée et parfumée aux épices, offrant une touche croquante, acidulée et rafraîchissante pour accompagner nos plats.",
      "cn": "店内自制泡菜，醋汁微甜、香料入味，口感爽脆酸甜，搭配菜品清爽解腻。",
      "en": "House-marinated fresh vegetables in a sweetened spiced vinegar brine — crunchy, tangy and refreshing to accompany your dishes."
    },
    "drink": {
      "fr": "Boisson au choix : lait de soja · coca · perrier · orangina · sprite · sirop",
      "cn": "指定饮品：豆浆、可乐、汽水、橘子、雪碧、糖浆水",
      "en": "Drink of your choice: soy milk · coke · perrier · orangina · sprite · syrup"
    },
    "soyMilk": {
      "fr": "Le lait de soja est servi froid par défaut. Si vous le préférez chaud, veuillez indiquer la température souhaitée au comptoir.",
